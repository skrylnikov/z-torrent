---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Z-Torrent Sintel Demo - Stream torrents in the browser" />
    <title>Z-Torrent — Sintel Demo</title>
  </head>
  <body>
    <main>
      <section id="hero" class="hero">
        <div class="hero-content">
          <h1>Z-Torrent</h1>
          <p class="tagline">Streaming torrent client for the web</p>
          <a class="github-link" href="https://github.com/skrylnikov/z-torrent" target="_blank" rel="noopener noreferrer">
            <svg class="github-icon" viewBox="0 0 16 16" width="20" height="20" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
        </div>

        <div id="videoWrap" class="video-wrap">
          <div class="videoOverlay"></div>
          <div class="video"></div>
        </div>

        <div id="progressBar" class="progress-bar"></div>

        <div class="stats">
          <div class="stats-row">
            <span class="show-leech">Downloading</span>
            <span class="show-seed">Seeding</span>
            <a href="/sintel.torrent" class="torrent-link">sintel.torrent</a>
            <span class="show-leech">from</span>
            <span class="show-seed">to</span>
            <span id="numPeers" class="stat-value">0 peers</span>
          </div>
          <div class="stats-row">
            <span id="downloaded" class="stat-value">0 B</span>
            of <span id="total" class="stat-value">0 B</span>
            — <span id="remaining">Connecting...</span>
          </div>
        </div>

        <div class="torrent-graph"></div>
      </section>
    </main>

    <script>
      import { initTorrentDemo } from '../scripts/torrent-demo';
      document.addEventListener('DOMContentLoaded', () => initTorrentDemo());
    </script>
  </body>
</html>
