# Magnet links (comma or newline separated). No backslash line continuation.
TORRENT_MAGNETS=magnet:?xt=urn:btih:08ada5a7a6183aae1e09d831df6748d566095a10&dn=Sintel

# Tracker URLs for announce (comma or newline separated).
# Include WSS trackers for WebTorrent browser clients.
TORRENT_TRACKERS=wss://tracker.openwebtorrent.com,wss://tracker.webtorrent.dev,wss://tracker.btorrent.xyz

# Directory for downloaded files
TORRENT_DOWNLOAD_PATH=./downloads

# Optional: HTTP port for streaming (0 = disabled)
TORRENT_HTTP_PORT=8080
