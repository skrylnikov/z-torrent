---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sintel — A short film by the Blender Foundation, streamed via BitTorrent" />
    <title>Sintel — Z-Torrent Demo</title>
  </head>
  <body>
    <main class="site">
      <section class="hero">
        <div class="hero-bg">
          <svg viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <radialGradient id="glow" cx="50%" cy="40%" r="50%">
                <stop offset="0%" stop-color="rgba(34,197,94,0.15)" />
                <stop offset="100%" stop-color="transparent" />
              </radialGradient>
              <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#0c1222" />
                <stop offset="60%" stop-color="#1a2744" />
                <stop offset="100%" stop-color="#2d3a5c" />
              </linearGradient>
            </defs>
            <rect width="800" height="450" fill="url(#sky)" />
            <rect width="800" height="450" fill="url(#glow)" />
            <circle cx="600" cy="80" r="40" fill="#fbbf24" opacity="0.8" />
            <circle cx="600" cy="80" r="55" fill="#fbbf24" opacity="0.15" />
            <path d="M0,320 Q100,280 200,310 Q350,350 500,300 Q650,260 800,290 L800,450 L0,450Z" fill="#1e293b" />
            <path d="M0,350 Q150,330 300,360 Q500,390 650,350 Q750,330 800,340 L800,450 L0,450Z" fill="#0f172a" />
            <g transform="translate(320, 160)" opacity="0.9">
              <path d="M60,80 L30,140 L50,140 L35,180 L85,125 L65,125 L90,80Z" fill="#22c55e" />
            </g>
            <g transform="translate(400, 200)">
              <ellipse cx="40" cy="70" rx="18" ry="24" fill="#64748b" opacity="0.7" />
              <circle cx="40" cy="42" r="16" fill="#64748b" opacity="0.7" />
            </g>
            <text x="400" y="420" text-anchor="middle" font-family="system-ui, sans-serif" font-size="13" fill="#22c55e" opacity="0.5">
              SINTEL (2010) — Blender Foundation
            </text>
          </svg>
        </div>

        <div class="hero-content">
          <div class="badge">Z-Torrent Host SDK Demo</div>
          <h1>Sintel</h1>
          <p class="tagline">
            A short film by the Blender Foundation. Sintel is a young woman searching for her lost
            baby dragon, traveling across mountains and forests in a beautifully animated fantasy
            world.
          </p>
          <div class="meta">
            <span class="meta-item">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              2010
            </span>
            <span class="meta-item">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              15 min
            </span>
            <span class="meta-item">Fantasy / Drama</span>
          </div>
          <div class="actions">
            <button id="watchBtn" class="btn btn-primary">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <polygon points="5,3 19,12 5,21" />
              </svg>
              Watch via P2P
            </button>
            <a class="btn btn-secondary" href="https://durian.blender.org/download/" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              Blender.org
            </a>
          </div>
        </div>
      </section>

      <section id="playerSection" class="player-section hidden">
        <div class="player-header">
          <h2>Sintel</h2>
          <div id="torrentStats" class="torrent-stats"></div>
        </div>
        <div class="player-container">
          <div id="loadingOverlay" class="loading-overlay">
            <div class="loading-spinner"></div>
            <p id="loadingText">Loading torrent metadata...</p>
            <div class="progress-track">
              <div id="progressFill" class="progress-fill"></div>
            </div>
            <p id="loadingDetail"></p>
          </div>
          <video id="videoPlayer" controls playsinline></video>
        </div>
        <div id="errorOverlay" class="error-overlay hidden">
          <p id="errorText"></p>
          <button id="retryBtn" class="btn btn-primary">Retry</button>
        </div>
      </section>

      <footer class="footer">
        <p>
          Hosted on <a href="https://z-torrent.xyz">Z-Torrent</a> — decentralized web hosting powered
          by BitTorrent. Video streamed via Host SDK + P2P.
        </p>
      </footer>
    </main>

    <script>
      import { initPlayer } from '../scripts/player'
      document.addEventListener('DOMContentLoaded', () => initPlayer())
    </script>
  </body>
</html>
