{
  "name": "bittorrent-dht",
  "description": "Simple, robust, BitTorrent DHT implementation",
  "type": "module",
  "version": "11.0.11",
  "author": {
    "name": "WebTorrent LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "bugs": {
    "url": "https://github.com/webtorrent/bittorrent-dht/issues"
  },
  "dependencies": {
    "bencode": "^4.0.0",
    "eventemitter3": "^5.0.4",
    "debug": "^4.4.3",
    "queue-microtask": "^1.2.3",
    "k-bucket": "^5.1.0",
    "k-rpc": "^5.1.0",
    "last-one-wins": "^1.0.4",
    "lru": "^3.1.0",
    "record-cache": "^1.2.0",
    "sync-sha1": "^1.0.1",
    "uint8-util": "^2.2.5"
  },
  "devDependencies": {
    "@types/bencode": "^2.0.4",
    "@types/debug": "^4.1.0",
    "@types/ip": "^1.1.3",
    "@types/node": "^20.0.0",
    "@types/once": "^1.4.5",
    "@types/run-parallel": "^1.1.2",
    "@webtorrent/semantic-release-config": "1.0.10",
    "bittorrent-dht-sodium": "1.2.0",
    "ip": "1.1.9",
    "once": "1.4.0",
    "run-parallel": "1.2.0",
    "semantic-release": "21.1.2"
  },
  "keywords": [
    "torrent",
    "bittorrent",
    "dht",
    "distributed hash table",
    "protocol",
    "peer",
    "p2p",
    "peer-to-peer"
  ],
  "engines": {
    "node": ">=12.20.0"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "update-authors": "./tools/update-authors.sh",
    "test": "bun test test/*.test.ts",
    "test-live": "bun test test/live/",
    "prepublishOnly": "npm run build",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "80 KB"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/feross"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/feross"
    },
    {
      "type": "consulting",
      "url": "https://feross.org/support"
    }
  ],
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ],
    "rangeStrategy": "bump"
  },
  "release": {
    "extends": "@webtorrent/semantic-release-config"
  }
}
