{
  "name": "@z-torrent/dht",
  "description": "BitTorrent DHT implementation (BEP 5, BEP 44)",
  "type": "module",
  "version": "0.0.10",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "dependencies": {
    "bencode": "^4.0.0",
    "debug": "^4.4.3",
    "eventemitter3": "^5.0.4",
    "k-bucket": "^5.1.0",
    "k-rpc": "^5.1.0",
    "last-one-wins": "^1.0.4",
    "lru-cache": "^11.2.4",
    "record-cache": "^1.2.0",
    "sync-sha1": "^1.0.1",
    "uint8-util": "^2.2.6"
  },
  "devDependencies": {
    "@types/bencode": "^2.0.4",
    "@types/debug": "^4.1.12",
    "@types/ip": "^1.1.3",
    "@types/node": "^22.19.3",
    "bittorrent-dht-sodium": "1.2.0",
    "ip": "1.1.9",
    "@z-torrent/utils": "workspace:*"
  },
  "keywords": [
    "torrent",
    "bittorrent",
    "dht",
    "webtorrent",
    "z-torrent",
    "distributed hash table",
    "protocol",
    "peer",
    "p2p",
    "peer-to-peer"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AUTHORS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/dht"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "update-authors": "./tools/update-authors.sh",
    "test": "bun test test/*.test.ts",
    "test-live": "bun test test/live/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "80 KB"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/feross"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/feross"
    },
    {
      "type": "consulting",
      "url": "https://feross.org/support"
    }
  ]
}
