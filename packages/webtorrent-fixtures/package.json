{
  "name": "webtorrent-fixtures",
  "description": "Sample torrent files for the WebTorrent test suite",
  "version": "2.0.2",
  "author": {
    "name": "WebTorrent, LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "bugs": {
    "url": "https://github.com/webtorrent/webtorrent-fixtures/issues"
  },
  "type": "module",
  "dependencies": {
    "parse-torrent": "workspace:*"
  },
  "devDependencies": {
    "@webtorrent/semantic-release-config": "1.0.10",
    "semantic-release": "21.1.2"
  },
  "keywords": [
    "sample torrents",
    "test",
    "test fixtures",
    "torrent",
    "torrent files",
    "webtorrent",
    "webtorrent test"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/webtorrent/webtorrent-fixtures.git"
  },
  "scripts": {
    "build": "tsdown",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "20 KB"
    }
  ],
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ]
  },
  "release": {
    "extends": "@webtorrent/semantic-release-config"
  }
}
