{
  "name": "string2compact",
  "description": "Convert 'hostname:port' strings to BitTorrent's compact ip/host binary returned by Trackers",
  "version": "2.0.1",
  "author": {
    "name": "WebTorrent, LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "bugs": {
    "url": "https://github.com/webtorrent/string2compact/issues"
  },
  "type": "module",
  "dependencies": {
    "addr-to-ip-port": "workspace:*",
    "ipaddr.js": "2.0.1"
  },
  "devDependencies": {
    "@webtorrent/semantic-release-config": "1.0.10",
    "compact2string": "1.4.1",
    "semantic-release": "21.1.2"
  },
  "keywords": [
    "binary",
    "bittorrent",
    "compact",
    "convert",
    "hostname",
    "peer-to-peer",
    "port",
    "torrent",
    "tracker",
    "webtorrent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/webtorrent/string2compact.git"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "15 KB"
    }
  ],
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ]
  },
  "release": {
    "extends": "@webtorrent/semantic-release-config"
  }
}
