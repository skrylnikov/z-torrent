{
  "name": "addr-to-ip-port",
  "description": "Convert an 'address:port' string to an array [address:string, port:number]",
  "type": "module",
  "version": "2.0.0",
  "author": {
    "name": "WebTorrent, LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "bugs": {
    "url": "https://github.com/webtorrent/addr-to-ip-port/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@webtorrent/semantic-release-config": "1.0.10",
    "benchmark": "2.1.4",
    "semantic-release": "21.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/webtorrent/addr-to-ip-port",
  "keywords": [
    "convert",
    "address",
    "port",
    "cache",
    "string",
    "array",
    "ip",
    "addr to ip port",
    "webtorrent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/webtorrent/addr-to-ip-port.git"
  },
  "scripts": {
    "build": "rolldown -c",
    "test": "bun test",
    "perf": "bun run perf/basic.ts",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "5 KB"
    }
  ],
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ]
  },
  "release": {
    "extends": "@webtorrent/semantic-release-config"
  }
}
