{
  "name": "ut_pex",
  "description": "Extension for Peer Discovery (PEX)",
  "version": "4.0.4",
  "author": {
    "name": "WebTorrent LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "bugs": {
    "url": "https://github.com/webtorrent/ut_pex/issues"
  },
  "type": "module",
  "dependencies": {
    "bencode": "^4.0.0",
    "eventemitter3": "^5.0.4",
    "compact2string": "^1.4.1",
    "string2compact": "workspace:*"
  },
  "devDependencies": {
    "@webtorrent/semantic-release-config": "1.0.10",
    "bittorrent-protocol": "workspace:*",
    "semantic-release": "21.1.2"
  },
  "keywords": [
    "PEX",
    "Peer Exchange",
    "bittorrent",
    "discovery",
    "extension",
    "p2p",
    "torrent",
    "ut_pex"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/webtorrent/ut_pex.git"
  },
  "scripts": {
    "build": "rolldown -c",
    "test": "bun test",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "30 KB"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/feross"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/feross"
    },
    {
      "type": "consulting",
      "url": "https://feross.org/support"
    }
  ],
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ],
    "rangeStrategy": "bump"
  },
  "release": {
    "extends": "@webtorrent/semantic-release-config"
  }
}
