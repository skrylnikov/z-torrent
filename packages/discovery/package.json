{
  "name": "@z-torrent/discovery",
  "description": "Discover BitTorrent peers (trackers, DHT, LSD, WebRTC)",
  "version": "0.0.14",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "browser": {
    "@z-torrent/dht": false,
    "@z-torrent/lsd": false
  },
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "type": "module",
  "dependencies": {
    "@z-torrent/dht": "workspace:*",
    "@z-torrent/lsd": "workspace:*",
    "@z-torrent/tracker": "workspace:*",
    "debug": "^4.4.3",
    "eventemitter3": "^5.0.4",
    "run-parallel": "^1.2.0",
    "uint8-util": "^2.2.6"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/run-parallel": "^1.1.2"
  },
  "keywords": [
    "webtorrent",
    "torrent",
    "bittorrent",
    "z-torrent",
    "peers",
    "discovery",
    "tracker",
    "dht",
    "lsd",
    "trackers",
    "find peers",
    "peer-to-peer",
    "peer discovery"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/discovery"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "120 KB"
    }
  ]
}
