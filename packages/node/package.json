{
  "name": "@z-torrent/node",
  "description": "Streaming torrent client",
  "version": "0.0.1",
  "author": {
    "name": "Z-Torrent Contributors",
    "email": "",
    "url": "https://github.com/webtorrent/webtorrent"
  },
  "type": "module",
  "browser": {
    "./src/common-node.js": false,
    "./src/client/http-tracker.js": false,
    "./src/client/udp-tracker.js": false,
    "./src/server.js": false,
    "socks": false
  },
  "bugs": {
    "url": "https://github.com/webtorrent/webtorrent/issues"
  },
  "dependencies": {
    "@z-torrent/core": "workspace:*",
    "@silentbot1/nat-api": "^0.4.9",
    "@thaunknown/simple-peer": "^10.0.11",
    "@webtorrent/http-node": "^1.3.0",
    "@z-torrent/utils": "workspace:*",
    "bitfield": "^4.2.0",
    "@z-torrent/dht": "workspace:*",
    "@z-torrent/protocol": "workspace:*",
    "cache-chunk-store": "^3.2.2",
    "chunk-store-iterator": "^1.0.4",
    "cpus": "^1.0.3",
    "@z-torrent/create": "workspace:*",
    "cross-fetch-ponyfill": "^1.0.3",
    "debug": "^4.4.3",
    "escape-html": "^1.0.3",
    "eventemitter3": "^5.0.4",
    "fs-chunk-store": "^5.0.0",
    "fsa-chunk-store": "^1.3.0",
    "immediate-chunk-store": "^2.2.0",
    "join-async-iterator": "^1.1.1",
    "lt_donthave": "^2.0.5",
    "memory-chunk-store": "^1.3.5",
    "mime": "^3.0.0",
    "@z-torrent/parse": "workspace:*",
    "pump": "^3.0.2",
    "random-iterate": "^1.0.1",
    "range-parser": "^1.2.1",
    "readable-stream": "^4.7.0",
    "run-parallel": "^1.2.0",
    "run-parallel-limit": "^1.1.0",
    "speed-limiter": "^1.0.2",
    "streamx": "2.22.1",
    "throughput": "^1.0.2",
    "@z-torrent/discovery": "workspace:*",
    "uint8-util": "^2.2.5",
    "unordered-array-remove": "^1.0.2",
    "@z-torrent/ut-metadata": "workspace:*",
    "@z-torrent/ut-pex": "workspace:*",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/plugin-syntax-import-assertions": "7.27.1",
    "@babel/preset-env": "7.28.5",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "airtap": "4.0.4",
    "airtap-manual": "1.0.0",
    "airtap-sauce": "1.1.2",
    "airtap-system": "^0.1.0",
    "babelify": "10.0.0",
    "@z-torrent/tracker": "workspace:*",
    "crypto-browserify": "^3.12.1",
    "stream-browserify": "^3.0.0",
    "disc": "1.3.3",
    "finalhandler": "2.1.1",
    "network-address": "1.1.2",
    "pako": "^2.1.0",
    "path-esm": "^1.0.0",
    "querystring": "^0.2.1",
    "run-series": "1.1.9",
    "serve-static": "2.2.0",
    "tap-parser": "^16.0.1",
    "tap-spec": "^5.0.0",
    "tape": "^5.9.0",
    "@z-torrent/fixtures": "workspace:*"
  },
  "optionalDependencies": {
    "utp-native": "^2.5.3",
    "webrtc-polyfill": "^1.1.5"
  },
  "engines": {
    "node": ">=16"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/feross"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/feross"
    },
    {
      "type": "consulting",
      "url": "https://feross.org/support"
    }
  ],
  "homepage": "https://github.com/webtorrent/webtorrent",
  "keywords": [
    "bittorrent",
    "bittorrent client",
    "download",
    "p2p",
    "peer-to-peer",
    "peers",
    "streaming",
    "swarm",
    "torrent",
    "web torrent",
    "webrtc",
    "webrtc data",
    "z-torrent"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/node"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build && npm run update-authors",
    "preversion": "npm run build && npm run update-authors",
    "size": "size-limit",
    "size-disc": "echo 'Use z-torrent-browser for browser build'",
    "size-js": "echo 'Use z-torrent-browser for browser build'",
    "test": "npm run test-node",
    "test-browser": "airtap --concurrency 1 --all -- test/*.test.ts test/browser/*.test.ts | tap-spec",
    "test-browser-local": "airtap --preset local -- test/*.test.ts test/browser/*.test.ts | tap-spec",
    "test-node": "bun test test/ test/node/",
    "test-single": "bun test test/node/client-deselect.test.ts",
    "update-authors": "./scripts/update-authors.sh"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "2 MB"
    }
  ]
}
