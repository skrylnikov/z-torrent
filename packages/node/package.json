{
  "name": "@z-torrent/node",
  "description": "Streaming torrent client for Node.js (Z-Torrent)",
  "version": "0.0.10",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "type": "module",
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "dependencies": {
    "@silentbot1/nat-api": "^0.4.9",
    "@thaunknown/simple-peer": "^10.0.11",
    "@z-torrent/core": "workspace:*",
    "@z-torrent/create": "workspace:*",
    "@z-torrent/dht": "workspace:*",
    "@z-torrent/discovery": "workspace:*",
    "@z-torrent/utils": "workspace:*",
    "cpus": "^1.0.3",
    "debug": "^4.4.3",
    "fs-chunk-store": "^5.0.0",
    "pump": "^3.0.2",
    "run-parallel": "^1.2.0",
    "streamx": "^2.22.1",
    "uint8-util": "^2.2.6"
  },
  "devDependencies": {
    "@z-torrent/fixtures": "workspace:*",
    "@z-torrent/tracker": "workspace:*",
    "memory-chunk-store": "^1.3.5",
    "run-series": "1.1.9",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "utp-native": "^2.5.3",
    "webrtc-polyfill": "^1.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "bittorrent",
    "bittorrent client",
    "download",
    "p2p",
    "peer-to-peer",
    "streaming",
    "torrent",
    "webrtc",
    "z-torrent"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AUTHORS.md"
  ],
  "homepage": "https://github.com/skrylnikov/z-torrent/tree/main/packages/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/node"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build && npm run update-authors",
    "preversion": "npm run build && npm run update-authors",
    "size": "size-limit",
    "size-disc": "echo 'Use z-torrent-browser for browser build'",
    "size-js": "echo 'Use z-torrent-browser for browser build'",
    "test": "bun test test/ test/node/",
    "test-live": "Z_TORRENT_LIVE=1 bun test test/ test/node/",
    "test-single": "bun test test/node/client-deselect.test.ts",
    "typecheck": "tsc --noEmit",
    "update-authors": "./scripts/update-authors.sh"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "2 MB"
    }
  ]
}
