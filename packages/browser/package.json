{
  "name": "@z-torrent/browser",
  "description": "Z-Torrent browser build — WebRTC, Service Worker, Web API bindings",
  "version": "0.0.9",
  "type": "module",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "main": "dist/z-torrent.min.js",
  "exports": {
    ".": {
      "import": "./dist/z-torrent.min.js",
      "types": "./dist/z-torrent.min.d.ts"
    },
    "./sw": {
      "import": "./dist/sw.min.js",
      "types": "./types/sw.d.ts"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.main.ts && tsdown -c tsdown.config.worker.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@z-torrent/utils": "workspace:*",
    "@z-torrent/core": "workspace:*",
    "@thaunknown/simple-peer": "^10.1.0",
    "@z-torrent/tracker": "workspace:*",
    "memory-chunk-store": "^1.3.5"
  },
  "devDependencies": {
    "crypto-browserify": "^3.12.1",
    "stream-browserify": "^3.0.0",
    "tsdown": "^0.21.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "webrtc-polyfill": "^1.1.5"
  },
  "peerDependenciesMeta": {
    "webrtc-polyfill": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "bittorrent",
    "bittorrent client",
    "browser",
    "download",
    "p2p",
    "peer-to-peer",
    "streaming",
    "torrent",
    "web torrent",
    "webrtc",
    "webrtc data",
    "z-torrent"
  ],
  "license": "MIT"
}
