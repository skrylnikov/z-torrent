{
  "name": "@z-torrent/browser",
  "description": "Z-Torrent browser build — WebRTC, Service Worker, Web API bindings",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/z-torrent.min.js",
  "exports": {
    ".": "./dist/z-torrent.min.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.main.ts && tsdown -c tsdown.config.worker.ts"
  },
  "dependencies": {
    "@z-torrent/core": "workspace:*",
    "@thaunknown/simple-peer": "^10.0.11",
    "@z-torrent/tracker": "workspace:*",
    "memory-chunk-store": "^1.3.5"
  },
  "devDependencies": {
    "tsdown": "^0.21.2"
  },
  "peerDependencies": {
    "webrtc-polyfill": "^1.1.5"
  },
  "peerDependenciesMeta": {
    "webrtc-polyfill": {
      "optional": true
    }
  },
  "keywords": [
    "bittorrent",
    "bittorrent client",
    "browser",
    "download",
    "p2p",
    "peer-to-peer",
    "streaming",
    "torrent",
    "web torrent",
    "webrtc",
    "webrtc data",
    "z-torrent"
  ],
  "license": "MIT"
}
