{
  "name": "@z-torrent/lsd",
  "description": "Local Service Discovery (BEP14) implementation",
  "version": "0.0.11",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "type": "module",
  "dependencies": {
    "debug": "^4.4.3",
    "eventemitter3": "^5.0.4"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12"
  },
  "keywords": [
    "bittorrent",
    "bep14",
    "lsd",
    "local service discovery",
    "protocol",
