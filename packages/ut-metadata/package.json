{
  "name": "@z-torrent/ut-metadata",
  "description": "Extension for Peers to Send Metadata Files (BEP 9)",
  "version": "0.0.9",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "type": "module",
  "dependencies": {
    "bencode": "^4.0.0",
    "eventemitter3": "^5.0.4",
    "bitfield": "^5.0.1",
    "debug": "^4.4.3",
    "uint8-util": "^2.2.6"
  },
  "devDependencies": {
    "@types/bencode": "^2.0.4",
    "@types/debug": "^4.1.12",
    "@z-torrent/fixtures": "workspace:*",
    "@z-torrent/protocol": "workspace:*"
  },
  "keywords": [
    "bep",
    "bep 9",
    "bep_0009",
    "bittorrent",
    "webtorrent",
    "z-torrent",
    "metadata",
    "p2p",
    "torrent",
    "ut_metadata"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/ut-metadata"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "25 KB"
    }
  ]
}
