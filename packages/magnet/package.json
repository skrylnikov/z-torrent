{
  "name": "@z-torrent/magnet",
  "description": "Parse a magnet URI and return an object of keys/values",
  "version": "0.0.5",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "type": "module",
  "dependencies": {
    "@thaunknown/thirty-two": "^1.0.5",
    "bep53-range": "^2.0.0",
    "uint8-util": "^2.2.6"
  },
  "keywords": [
    "bittorrent",
    "cryptolinks",
    "magnet",
    "p2p",
    "peer-to-peer",
    "uri",
    "urn",
    "webtorrent",
    "z-torrent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/magnet"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "15 KB"
    }
  ]
}
