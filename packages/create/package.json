{
  "name": "@z-torrent/create",
  "description": "Create .torrent files",
  "version": "0.0.16",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "type": "module",
  "bin": {
    "create-torrent": "./dist/bin/cmd.js"
  },
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "browser": {
    "is-file": false
  },
  "dependencies": {
    "@z-torrent/merkle-tree": "workspace:*",
    "@z-torrent/utils": "workspace:*",
    "bencode": "^4.0.0",
    "block-iterator": "^1.1.1",
    "is-file": "^1.0.0",
    "join-async-iterator": "^1.1.1",
    "junk": "^4.0.1",
    "minimist": "^1.2.8",
    "run-parallel": "^1.2.0",
    "uint8-util": "^2.2.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@z-torrent/fixtures": "workspace:*",
    "@z-torrent/parse": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    ".torrent",
    "bittorrent",
    "create",
    "create torrent",
    "make",
    "new",
    "peer-to-peer",
    "torrent",
    "torrent file",
    "torrent files",
    "webtorrent",
    "z-torrent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/create"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "test:browser": "bun test test/browser/",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "50 KB"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/feross"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/feross"
    },
    {
      "type": "consulting",
      "url": "https://feross.org/support"
    }
  ]
}
