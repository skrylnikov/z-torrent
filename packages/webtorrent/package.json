{
  "name": "z-torrent",
  "description": "Streaming torrent client",
  "version": "2.8.5",
  "author": {
    "name": "Z-Torrent Contributors",
    "email": "",
    "url": "https://github.com/webtorrent/webtorrent"
  },
  "type": "module",
  "browser": {
    "./src/common-node.js": false,
    "./src/client/http-tracker.js": false,
    "./src/client/udp-tracker.js": false,
    "./src/server.js": false,
    "socks": false
  },
  "bugs": {
    "url": "https://github.com/webtorrent/webtorrent/issues"
  },
  "dependencies": {
    "@silentbot1/nat-api": "^0.4.9",
    "@thaunknown/simple-peer": "^10.0.11",
    "@webtorrent/http-node": "^1.3.0",
    "addr-to-ip-port": "workspace:*",
    "bitfield": "^4.2.0",
    "bittorrent-dht": "workspace:*",
    "bittorrent-protocol": "workspace:*",
    "cache-chunk-store": "^3.2.2",
    "chunk-store-iterator": "^1.0.4",
    "cpus": "^1.0.3",
    "create-torrent": "workspace:*",
    "cross-fetch-ponyfill": "^1.0.3",
    "debug": "^4.4.3",
    "escape-html": "^1.0.3",
    "fs-chunk-store": "^5.0.0",
    "fsa-chunk-store": "^1.3.0",
    "immediate-chunk-store": "^2.2.0",
    "join-async-iterator": "^1.1.1",
    "load-ip-set": "workspace:*",
    "lt_donthave": "^2.0.5",
    "memory-chunk-store": "^1.3.5",
    "mime": "^3.0.0",
    "once": "^1.4.0",
    "parse-torrent": "workspace:*",
    "pump": "^3.0.2",
    "queue-microtask": "^1.2.3",
    "random-iterate": "^1.0.1",
    "range-parser": "^1.2.1",
    "run-parallel": "^1.2.0",
    "run-parallel-limit": "^1.1.0",
    "speed-limiter": "^1.0.2",
    "streamx": "2.22.1",
    "throughput": "^1.0.2",
    "torrent-discovery": "workspace:*",
    "torrent-piece": "workspace:*",
    "uint8-util": "^2.2.5",
    "unordered-array-remove": "^1.0.2",
    "ut_metadata": "workspace:*",
    "ut_pex": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/plugin-syntax-import-assertions": "7.27.1",
    "@babel/preset-env": "7.28.5",
    "@webtorrent/semantic-release-config": "1.0.10",
    "airtap": "4.0.4",
    "airtap-manual": "1.0.0",
    "airtap-sauce": "1.1.2",
    "airtap-system": "^0.1.0",
    "babelify": "10.0.0",
    "bittorrent-tracker": "workspace:*",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "disc": "1.3.3",
    "finalhandler": "2.1.1",
    "network-address": "1.1.2",
    "pako": "^2.1.0",
    "path-esm": "^1.0.0",
    "querystring": "^0.2.1",
    "run-series": "1.1.9",
    "semantic-release": "22.0.12",
    "serve-static": "2.2.0",
    "stream-browserify": "^3.0.0",
    "tap-parser": "^16.0.1",
    "tap-spec": "^5.0.0",
    "tape": "^5.9.0",
    "tsx": "^4.21.0",
    "timers-browserify": "^2.0.12",
    "webtorrent-fixtures": "workspace:*"
  },
  "optionalDependencies": {
    "utp-native": "^2.5.3",
    "webrtc-polyfill": "^1.1.5"
  },
  "engines": {
    "node": ">=16"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/feross"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/feross"
    },
    {
      "type": "consulting",
      "url": "https://feross.org/support"
    }
  ],
  "homepage": "https://github.com/webtorrent/webtorrent",
  "keywords": [
    "bittorrent",
    "bittorrent client",
    "download",
    "p2p",
    "peer-to-peer",
    "peers",
    "streaming",
    "swarm",
    "torrent",
    "web torrent",
    "webrtc",
    "webrtc data",
    "z-torrent"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/webtorrent/webtorrent.git"
  },
  "scripts": {
    "build": "rolldown -c && rolldown -c rolldown.config.worker.ts",
    "build-browser": "rolldown -c rolldown.config.browser.ts && rolldown -c rolldown.config.worker.ts",
    "build-js": "rolldown -c rolldown.config.browser.ts",
    "build-js-worker": "rolldown -c rolldown.config.worker.ts",
    "prepublishOnly": "npm run build && npm run update-authors",
    "preversion": "npm run build && npm run update-authors",
    "size": "size-limit",
    "size-disc": "npm run build-js && cat ./dist/z-torrent.min.js | discify --open",
    "size-js": "npm run build-js && cat ./dist/z-torrent.min.js | gzip | wc -c",
    "test": "npm run test-node",
    "test-browser": "airtap --concurrency 1 --all -- test/*.ts test/browser/*.ts | tap-spec",
    "test-browser-local": "airtap --preset local -- test/*.ts test/browser/*.ts | tap-spec",
    "test-node": "tsx test/*.ts test/node/*.ts | tap-spec",
    "test-single": "tsx test/node/client-deselect.ts | tap-spec",
    "update-authors": "./scripts/update-authors.sh"
  },
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ],
    "rangeStrategy": "bump"
  },
  "release": {
    "extends": "@webtorrent/semantic-release-config"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "2 MB"
    }
  ]
}
