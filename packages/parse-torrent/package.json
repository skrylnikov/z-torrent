{
  "name": "parse-torrent",
  "description": "Parse a torrent identifier (magnet uri, .torrent file, info hash)",
  "version": "11.0.19",
  "author": {
    "name": "WebTorrent LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "browser": {
    "fs": false
  },
  "bin": {
    "parse-torrent": "./dist/bin/cmd.js"
  },
  "bugs": {
    "url": "https://github.com/webtorrent/parse-torrent/issues"
  },
  "type": "module",
  "dependencies": {
    "bencode": "^4.0.0",
    "cross-fetch-ponyfill": "^1.0.3",
    "get-stdin": "^9.0.0",
    "magnet-uri": "workspace:*",
    "queue-microtask": "^1.2.3",
    "uint8-util": "^2.2.5",
    "sync-sha1": "^1.0.1"
  },
  "devDependencies": {
    "@webtorrent/semantic-release-config": "1.0.10",
    "semantic-release": "21.1.2"
  },
  "keywords": [
    ".torrent",
    "bittorrent",
    "parse torrent",
    "peer-to-peer",
    "read torrent",
    "torrent",
    "webtorrent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/webtorrent/parse-torrent.git"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test test/ test/node/",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "30 KB"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/feross"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/feross"
    },
    {
      "type": "consulting",
      "url": "https://feross.org/support"
    }
  ],
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ],
    "rangeStrategy": "bump"
  },
  "release": {
    "extends": "@webtorrent/semantic-release-config"
  }
}
