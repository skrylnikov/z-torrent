{
  "name": "@z-torrent/protocol",
  "type": "module",
  "description": "Simple, robust, BitTorrent peer wire protocol implementation",
  "version": "0.0.12",
  "author": {
    "name": "WebTorrent LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "dependencies": {
    "bencode": "^4.0.0",
    "bitfield": "^5.0.1",
    "debug": "^4.4.3",
    "rc4": "^0.1.5",
    "streamx": "^2.22.1",
    "throughput": "^1.0.2",
    "uint8-util": "^2.2.5",
    "unordered-array-remove": "^1.0.2"
  },
  "engines": {
    "node": ">=12.20.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "50 KB"
    }
  ],
  "keywords": [
    "bittorrent",
    "p2p",
    "peer",
    "peer-to-peer",
    "protocol",
    "stream",
    "torrent",
    "wire"
  ],
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/feross"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/feross"
    },
    {
      "type": "consulting",
      "url": "https://feross.org/support"
    }
  ]
}
