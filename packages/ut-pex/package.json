{
  "name": "@z-torrent/ut-pex",
  "description": "Extension for Peer Discovery (PEX)",
  "version": "0.0.11",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "type": "module",
  "dependencies": {
    "bencode": "^4.0.0",
    "eventemitter3": "^5.0.4",
    "@z-torrent/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/bencode": "^2.0.4",
    "@z-torrent/protocol": "workspace:*"
  },
  "keywords": [
    "PEX",
    "Peer Exchange",
    "bittorrent",
    "webtorrent",
    "z-torrent",
    "discovery",
    "extension",
    "p2p",
    "torrent",
    "ut_pex"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/ut-pex"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "30 KB"
    }
  ]
}
