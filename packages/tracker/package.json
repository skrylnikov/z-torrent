{
  "name": "@z-torrent/tracker",
  "description": "BitTorrent tracker client and server (HTTP, UDP, WebSocket / WebTorrent)",
  "version": "0.0.6",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "bin": {
    "bittorrent-tracker": "./dist/bin/cmd.js"
  },
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "browser": {
        "import": "./dist/client.browser.js",
        "types": "./dist/client.browser.d.ts"
      },
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./websocket-tracker": {
      "import": "./dist/lib/client/websocket-tracker.js",
      "types": "./dist/lib/client/websocket-tracker.d.ts"
    }
  },
  "keywords": [
    "bittorrent",
    "p2p",
    "peer",
    "peer-to-peer",
    "stream",
    "torrent",
    "tracker",
    "webtorrent",
    "z-torrent",
    "wire"
  ],
  "license": "MIT",
  "dependencies": {
    "@thaunknown/simple-peer": "^10.1.0",
    "@thaunknown/simple-websocket": "^9.1.3",
    "@z-torrent/utils": "workspace:*",
    "bencode": "^4.0.0",
    "bittorrent-peerid": "^1.3.6",
    "debug": "^4.4.3",
    "eventemitter3": "^5.0.4",
    "ip": "^2.0.1",
    "lru-cache": "^11.2.7",
    "minimist": "^1.2.8",
    "random-iterate": "^1.0.1",
    "run-parallel": "^1.2.0",
    "run-series": "^1.1.9",
    "socks": "^2.8.7",
    "uint8-util": "^2.2.6",
    "unordered-array-remove": "^1.0.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bencode": "^2.0.4",
    "@types/debug": "^4.1.13",
    "@types/ip": "^1.1.3",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "@z-torrent/fixtures": "workspace:*",
    "@z-torrent/magnet": "workspace:*",
    "typescript": "^5.9.3",
    "webrtc-polyfill": "^1.2.0",
    "wrtc": "^0.4.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/tracker"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts && tsdown -c tsdown.browser.config.ts",
    "preversion": "npm run update-authors",
    "prepublishOnly": "npm run build",
    "test": "bun test --timeout 30000 --max-concurrency=1",
    "typecheck": "tsc --noEmit",
    "update-authors": "./tools/update-authors.sh",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "100 KB"
    }
  ]
}
