{
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*", "test/**/*", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
