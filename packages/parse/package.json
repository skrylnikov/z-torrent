{
  "name": "@z-torrent/parse",
  "description": "Parse a torrent identifier (magnet uri, .torrent file, info hash)",
  "version": "0.0.9",
  "author": "Dmitriy Skrylnikov <skrylnikovd@ya.ru>",
  "bugs": {
    "url": "https://github.com/skrylnikov/z-torrent/issues"
  },
  "bin": {
    "parse-torrent": "./dist/bin/cmd.js"
  },
  "type": "module",
  "dependencies": {
    "bencode": "^4.0.0",
    "@z-torrent/magnet": "workspace:*",
    "uint8-util": "^2.2.6",
    "sync-sha1": "^1.0.1"
  },
  "keywords": [
    ".torrent",
    "bittorrent",
    "parse torrent",
    "peer-to-peer",
    "read torrent",
    "torrent",
    "webtorrent",
    "z-torrent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrylnikov/z-torrent.git",
    "directory": "packages/parse"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "30 KB"
    }
  ],
  "devDependencies": {
    "@types/bencode": "^2.0.4"
  }
}
