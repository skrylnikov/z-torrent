{
  "name": "bittorrent-tracker",
  "description": "Simple, robust, BitTorrent tracker (client & server) implementation",
  "version": "11.2.2",
  "author": {
    "name": "WebTorrent LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "bin": {
    "bittorrent-tracker": "./dist/bin/cmd.js"
  },
  "browser": {
    "./lib/common-node.js": false,
    "./lib/client/http-tracker.js": false,
    "./lib/client/udp-tracker.js": false,
    "./server.js": false,
    "socks": false
  },
  "bugs": {
    "url": "https://github.com/webtorrent/bittorrent-tracker/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./websocket-tracker": {
      "import": {
        "types": "./dist/lib/client/websocket-tracker.d.ts",
        "default": "./dist/lib/client/websocket-tracker.js"
      }
    }
  },
  "keywords": [
    "bittorrent",
    "p2p",
    "peer",
    "peer-to-peer",
    "stream",
    "torrent",
    "tracker",
    "wire"
  ],
  "license": "MIT",
  "dependencies": {
    "@thaunknown/simple-peer": "^10.0.8",
    "@thaunknown/simple-websocket": "^9.1.3",
    "bencode": "^4.0.0",
    "bittorrent-peerid": "^1.3.6",
    "compact2string": "^1.4.1",
    "cross-fetch-ponyfill": "^1.0.3",
    "debug": "^4.3.4",
    "ip": "^2.0.1",
    "lru": "^3.1.0",
    "minimist": "^1.2.8",
    "once": "^1.4.0",
    "queue-microtask": "^1.2.3",
    "random-iterate": "^1.0.1",
    "run-parallel": "^1.2.0",
    "run-series": "^1.1.9",
    "socks": "^2.8.3",
    "string2compact": "workspace:*",
    "uint8-util": "^2.2.5",
    "unordered-array-remove": "^1.0.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@mapbox/node-pre-gyp": "1.0.11",
    "@types/bencode": "^2.0.4",
    "@types/debug": "^4.1.12",
    "@types/ip": "^1.1.3",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.5",
    "@types/once": "^1.4.5",
    "@types/tape": "^5.8.0",
    "@types/ws": "^8.5.13",
    "@webtorrent/semantic-release-config": "1.0.10",
    "magnet-uri": "workspace:*",
    "rolldown": "^1.0.0-beta.1",
    "semantic-release": "21.1.2",
    "standard": "*",
    "tape": "5.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.2",
    "undici": "^6.16.1",
    "webrtc-polyfill": "^1.1.5",
    "webtorrent-fixtures": "workspace:*"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/webtorrent/bittorrent-tracker.git"
  },
  "scripts": {
    "build": "tsc && rolldown -c rolldown.config.ts",
    "preversion": "npm run update-authors",
    "prepublishOnly": "npm run build",
    "test": "standard && tsx test/*.ts",
    "update-authors": "./tools/update-authors.sh",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "100 KB"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/feross"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/feross"
    },
    {
      "type": "consulting",
      "url": "https://feross.org/support"
    }
  ],
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ]
  },
  "release": {
    "extends": "@webtorrent/semantic-release-config"
  },
  "standard": {
    "ignore": [
      "dist/**"
    ]
  }
}
