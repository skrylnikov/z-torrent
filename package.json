{
  "name": "z-torrent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "node-datachannel"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test-live": "turbo run test-live",
    "lint": "eslint packages",
    "lint:fix": "eslint packages --fix",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"packages/**/*.{js,ts,tsx,json,md}\"",
    "size": "turbo size",
    "deps:count": "bun scripts/count-deps.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@size-limit/file": "^12.0.1",
    "@types/node": "^25.3.5",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.4.0",
    "prettier": "^3.2.5",
    "rolldown": "^1.0.0-rc.7",
    "size-limit": "^12.0.1",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.15.0"
  },
  "packageManager": "bun@1.3.9"
}
