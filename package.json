{
  "name": "z-torrent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "trustedDependencies": [
    "node-datachannel"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "test-live": "turbo run test-live",
    "lint": "eslint packages",
    "lint:fix": "eslint packages --fix",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"packages/**/*.{js,ts,tsx,json,md}\"",
    "size": "turbo size",
    "deps:count": "bun scripts/count-deps.ts",
    "changeset": "changeset",
    "version": "changeset version && bun install --lockfile-only",
    "release": "changeset publish",
    "release:check": "changeset status"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.0",
    "@size-limit/file": "^12.0.1",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.4.0",
    "prettier": "^3.2.5",
    "size-limit": "^12.0.1",
    "tsdown": "^0.21.3",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.15.0"
  },
  "packageManager": "bun@1.3.9",
  "dependencies": {
    "@types/bencode": "^2.0.4",
    "bencode": "^4.0.0",
    "sync-sha1": "^1.0.1",
    "uint8-util": "^2.2.6"
  }
}
